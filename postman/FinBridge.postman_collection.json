{
  "info": {
    "name": "FinBridge",
    "description": "The FinBridge REST API, in the order of a demo: sign in, look around, synchronize from Odoo, pay an invoice through the SOAP payment service, reconcile, monitor, administer.\n\nImport FinBridge.postman_environment.json as well and fill in adminEmail, adminPassword and simApiKey (the values of BOOTSTRAP_ADMIN_EMAIL, BOOTSTRAP_ADMIN_PASSWORD and SIM_API_KEY in .env). Run the folders top to bottom: each request saves what the next one needs.\n\nEvery request has tests, so the whole collection can be run with the Collection Runner or newman as a smoke test. The Payments folder pays one real (simulated) invoice each time it finds an open one, and skips itself when there is none.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 Sign in",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Public. Saves the token for every later request. Tokens last 60 minutes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('a token and the user come back', () => { pm.expect(d.accessToken).to.be.a('string'); pm.expect(d.user.roles).to.be.an('array'); });",
                  "pm.environment.set('accessToken', d.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password is refused without saying why",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@finbridge.local\",\n  \"password\": \"certainly-not-right\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('one generic message', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('no password hash', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "No token, no data",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/invoices"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('error envelope with a correlation id', () => { const b = pm.response.json(); pm.expect(b.error.code).to.eql('UNAUTHENTICATED'); pm.expect(b.correlationId).to.be.a('string'); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.auth = { type: 'noauth' };"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Look around",
      "item": [
        {
          "name": "Dashboard summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/dashboard/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('figures come from live data', () => pm.expect(pm.response.json().data.invoiceCount).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Suppliers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/suppliers?size=5&sort=name,asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('a paged list', () => pm.expect(pm.response.json().meta.totalElements).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invoices, newest first",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/invoices?size=10&sort=invoiceDate,desc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('a paged list', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sorting by a column that is not allowed",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/invoices?sort=version,asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('the allowed fields are named', () => pm.expect(pm.response.json().error.message).to.include('Allowed'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 Synchronize from Odoo",
      "item": [
        {
          "name": "Integration status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/integrations/status"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Odoo mode is REAL or MOCK', () => pm.expect(['REAL', 'MOCK']).to.include(pm.response.json().data.odoo.mode));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health check",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/integrations/health-check",
            "description": "Calls Odoo, fetches the payment service's WSDL and asks the simulator for its health, now."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('Odoo, SOAP and REST all answer', () => { pm.expect(d.odoo.ok, 'odoo').to.be.true; pm.expect(d.soap.ok, 'soap').to.be.true; pm.expect(d.rest.ok, 'rest').to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Start a synchronization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/integrations/odoo/sync",
            "description": "202: the run executes in the background. 409 if one is already running.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullResync\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "pm.environment.set('syncRunId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll the synchronization run until it has finished",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/integrations/odoo/sync-runs/{{syncRunId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const run = pm.response.json().data.run;",
                  "if (run.status === 'RUNNING') { setTimeout(() => {}, 500); pm.execution.setNextRequest(pm.info.requestName); }",
                  "else { pm.test('the run did not fail', () => pm.expect(['COMPLETED', 'PARTIAL']).to.include(run.status)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Runs so far",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/integrations/odoo/sync-runs?size=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 Pay an invoice",
      "item": [
        {
          "name": "Find an open invoice",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/invoices?status=OPEN&size=1&sort=invoiceDate,asc",
            "description": "Also creates the Idempotency-Key for this payment intention: once, here, not per attempt."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().data;",
                  "if (rows.length === 0) { pm.environment.unset('invoiceId'); console.log('No open invoice: the payment requests will be skipped. Post a bill in Odoo and synchronize.'); }",
                  "else { pm.environment.set('invoiceId', rows[0].id); pm.environment.set('invoiceNumber', rows[0].invoiceNumber); pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}')); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulator: make sure this invoice has no scenario",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Sim-Api-Key",
                "value": "{{simApiKey}}"
              }
            ],
            "url": "{{simUrl}}/sim/scenarios/{{invoiceNumber}}",
            "description": "The simulator's own REST control, protected by X-Sim-Api-Key. To see another outcome, send PUT here instead with body {\"scenario\": \"SLOW_SUCCESS\"} (or FAILED, REJECTED, PENDING_THEN_SUCCESS, SHORT_PAY, OUTAGE) before paying."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('invoiceId')) { pm.execution.skipRequest(); }",
                  "pm.request.auth = { type: 'noauth' };"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay it",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payments",
            "description": "The amount and currency come from the invoice, never from the request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": {{invoiceId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.environment.set('paymentId', d.id);",
                  "pm.test('first time, not a replay', () => pm.expect(pm.response.headers.get('Idempotent-Replay')).to.eql('false'));",
                  "pm.test('paid', () => pm.expect(d.status).to.eql('SUCCESS'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('invoiceId')) { pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Send exactly the same request again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payments",
            "description": "A double click or a network retry. Nothing is sent to the payment service.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": {{invoiceId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('the same transaction, marked as a replay', () => { pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('paymentId')); pm.expect(pm.response.headers.get('Idempotent-Replay')).to.eql('true'); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('invoiceId')) { pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "A new key for the same invoice is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": {{invoiceId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('conflict', () => pm.expect(pm.response.json().error.code).to.eql('CONFLICT'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('invoiceId')) { pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "The payment with its calls to the payment service",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payments/{{paymentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('one SOAP call was recorded', () => pm.expect(d.attempts.length).to.be.at.least(1));",
                  "pm.environment.set('logId', d.attempts[0].logId);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('invoiceId')) { pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "That call's SOAP request and response",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/integrations/logs/{{logId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('the XML is stored', () => pm.expect(pm.response.json().data.requestPayload).to.include('SubmitPaymentRequest'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('invoiceId')) { pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "A status check on a paid payment is refused",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/payments/{{paymentId}}/status-check",
            "description": "Status checks are for PENDING and TIMEOUT_UNKNOWN payments only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 422', () => pm.response.to.have.status(422));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('invoiceId')) { pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/payments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('the header is named', () => pm.expect(pm.response.json().error.message).to.include('Idempotency-Key'));"
                ]
              }
            }
          ]
        },
        {
          "name": "All payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payments?size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 Reconcile",
      "item": [
        {
          "name": "Run a reconciliation for today",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reconciliation/run",
            "description": "Dates are UTC and inclusive. The run fetches the settlement statement over SOAP.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"periodFrom\": \"{{today}}\",\n  \"periodTo\": \"{{today}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
                  "pm.environment.set('reconciliationRunId', pm.response.json().data.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('today', new Date().toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll the reconciliation run until it has finished",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reconciliation/runs/{{reconciliationRunId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const run = pm.response.json().data;",
                  "if (run.status === 'RUNNING') { pm.execution.setNextRequest(pm.info.requestName); }",
                  "else { pm.test('completed', () => pm.expect(run.status).to.eql('COMPLETED')); pm.test('counts add up', () => pm.expect(run.matchedCount + run.discrepancyCount).to.eql(run.totalRecords)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Its records",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reconciliation?runId={{reconciliationRunId}}&size=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().data;",
                  "if (rows.length > 0) { pm.environment.set('recordId', rows[0].id); } else { pm.environment.unset('recordId'); }"
                ]
              }
            }
          ]
        },
        {
          "name": "One record, both sides field by field",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/reconciliation/{{recordId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('a comparison is included', () => pm.expect(pm.response.json().data.comparison).to.be.an('array'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('recordId')) { pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
        {
          "name": "A review without a note is refused",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reconciliation/{{recordId}}/review",
            "description": "To review for real, add \"note\": \"...\". Only RESOLVED and NEEDS_INVESTIGATION are accepted, and a MATCHED record needs no review (422).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewStatus\": \"RESOLVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('the note is the problem', () => pm.expect(pm.response.json().error.fieldErrors[0].field).to.eql('note'));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('recordId')) { pm.execution.skipRequest(); }"
                ]
              }
            }
          ]
        },
